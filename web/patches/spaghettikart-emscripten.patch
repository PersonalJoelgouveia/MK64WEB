--- a/src/main.c
+++ b/src/main.c
@@ -39,6 +39,10 @@
 #include "engine/wasm.h"
 #include "port/Game.h"
 #include "port/Engine.h"
+#ifdef __EMSCRIPTEN__
+#include "web/mk64_input.h"
+#include "webnet.h"
+#endif
 #include "engine/Matrix.h"
 #include "engine/TrackBrowser.h"
 
@@ -395,6 +399,39 @@ void read_controllers(void) {
     osContStartReadData(&gSIEventMesgQueue);
     // osRecvMesg(&gSIEventMesgQueue, &msg, OS_MESG_BLOCK);
     osContGetReadData(gControllerPads);
+#ifdef __EMSCRIPTEN__
+    {   /* entrada vinda do input.js (teclado/gamepad/toque), somada à do SDL */
+        uint16_t b; int8_t sx, sy;
+        mk64_read_pad(0, &b, &sx, &sy);
+        gControllerPads[0].button |= b;
+        if (sx != 0 || sy != 0) { gControllerPads[0].stick_x = sx; gControllerPads[0].stick_y = sy; }
+    }
+    if (mk64_net_active()) {
+        /* Multiplayer lockstep: o comando local vai para o outro jogador; os jogadores
+           (portas 0 a 3 = jogadores 1 a 4) vêm do buffer sincronizado. */
+        extern u16 gRandomSeed16;
+        union { f32 f; u32 u; } c;
+        u32 h = 2166136261u, i, k;
+        u32 vals[3 + 4 * 7];
+        vals[0] = gRandomSeed16; vals[1] = (u32) gGlobalTimer; vals[2] = 0;
+        for (i = 0; i < 4; i++) {
+            for (k = 0; k < 3; k++) { c.f = gPlayers[i].pos[k]; vals[3 + i * 7 + k] = c.u; }
+            for (k = 0; k < 3; k++) { c.f = gPlayers[i].velocity[k]; vals[3 + i * 7 + 3 + k] = c.u; }
+            c.f = gPlayers[i].speed; vals[3 + i * 7 + 6] = c.u;
+        }
+        for (i = 0; i < 3 + 4 * 7; i++) { h = (h ^ vals[i]) * 16777619u; }
+        mk64_net_submit(((u32) (u16) gControllerPads[0].button) | ((u32) (u8) gControllerPads[0].stick_x << 16) |
+                            ((u32) (u8) gControllerPads[0].stick_y << 24),
+                        h);
+        for (i = 0; i < 4; i++) {
+            u32 v = mk64_net_get((int) i);
+            gControllerPads[i].button = (u16) (v & 0xFFFF);
+            gControllerPads[i].stick_x = (s8) ((v >> 16) & 0xFF);
+            gControllerPads[i].stick_y = (s8) ((v >> 24) & 0xFF);
+            gControllerPads[i].err_no = 0;
+        }
+    }
+#endif
     update_controller(0);
     update_controller(1);
     update_controller(2);
