diff --git a/cmake/dependencies/emscripten.cmake b/cmake/dependencies/emscripten.cmake
new file mode 100644
index 0000000..fd04f27
--- /dev/null
+++ b/cmake/dependencies/emscripten.cmake
@@ -0,0 +1,13 @@
+#=================== ImGui (Emscripten / WebGL2) ===================
+find_package(SDL2 REQUIRED CONFIG)
+if(NOT TARGET SDL2::SDL2)
+    add_library(SDL2::SDL2 INTERFACE IMPORTED)
+    target_link_libraries(SDL2::SDL2 INTERFACE SDL2::SDL2-static)
+endif()
+target_link_libraries(ImGui PUBLIC SDL2::SDL2)
+
+# No navegador só existe OpenGL ES 3 (WebGL2).
+if(NOT USE_OPENGLES)
+    message(FATAL_ERROR "Emscripten requer -DUSE_OPENGLES=ON (WebGL2)")
+endif()
+add_compile_definitions(IMGUI_IMPL_OPENGL_ES3)
